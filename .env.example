# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Production site URL (Vercel domain or custom domain, no trailing slash)
# Used for SEO metadata, sitemap, and canonical URLs.
NEXT_PUBLIC_SITE_URL=

# OPTIONAL, server-side only. This MVP does not require it.
# If you later add server jobs that need it, set it ONLY in Vercel
# env vars — NEVER with a NEXT_PUBLIC_ prefix, never in client code.
# SUPABASE_SERVICE_ROLE_KEY=

# QPay (server-side only, for real payment integration later)
# QPAY_USERNAME=
# QPAY_PASSWORD=
# QPAY_INVOICE_CODE=
